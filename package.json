{
  "name": "everest-new-lp",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "vite --port 8000",
    "start": "vite --port 3000",
    "dev:legacy": "vite --port 8000",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:cms": "bun run --cwd apps/cms dev",
    "dev:migration": "concurrently -n cms,web -c blue,green \"bun run dev:cms\" \"bun run dev:web\"",
    "dev:stable": "VITE_DISABLE_HMR=true vite --port 8000",
    "build": "vite build && tsc",
    "build:web": "bun run --cwd apps/web build",
    "build:analyze": "vite build --mode analyze",
    "serve": "vite preview",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "lint:cms": "bun run --cwd apps/cms lint",
    "check:seed": "bun run --cwd apps/cms check:seed",
    "check:news": "bun run --cwd apps/web check:news",
    "check:lead": "bun run --cwd apps/web check:lead",
    "seed:admin": "bun run --cwd apps/cms seed:admin",
    "seed:publications": "bun run --cwd apps/cms seed:publications",
    "seed:site-content": "bun run --cwd apps/cms seed:site-content",
    "migrate:export": "bunx convex export --path scripts/migration/.exports/convex-dev.zip",
    "migrate:import": "bun run --cwd apps/cms import:convex",
    "jobs:fetch-news": "bun run --cwd apps/cms jobs:fetch-news",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "cms:dev": "concurrently \"bun run convex:dev\" \"bun run dev\"",
    "cms:dev:stable": "concurrently \"bun run convex:dev\" \"bun run dev:stable\""
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@aws-sdk/client-s3": "3.887.0",
    "@aws-sdk/s3-request-presigner": "3.887.0",
    "@convex-dev/auth": "0.0.88",
    "@tailwindcss/vite": "4.1.12",
    "@tanstack/react-devtools": "0.2.2",
    "@tanstack/react-router": "1.130.2",
    "@tanstack/react-router-devtools": "1.131.5",
    "@tiptap/extension-color": "3.22.5",
    "@tiptap/extension-highlight": "3.22.5",
    "@tiptap/extension-horizontal-rule": "3.22.5",
    "@tiptap/extension-image": "3.3.1",
    "@tiptap/extension-link": "3.3.1",
    "@tiptap/extension-subscript": "3.22.5",
    "@tiptap/extension-superscript": "3.22.5",
    "@tiptap/extension-table": "3.3.1",
    "@tiptap/extension-table-cell": "3.3.1",
    "@tiptap/extension-table-header": "3.3.1",
    "@tiptap/extension-table-row": "3.3.1",
    "@tiptap/extension-text-align": "3.22.5",
    "@tiptap/extension-text-style": "3.22.5",
    "@tiptap/react": "3.3.1",
    "@tiptap/starter-kit": "3.3.1",
    "@types/three": "0.179.0",
    "@uploadthing/react": "7.1.0",
    "convex": "1.26.2",
    "dompurify": "3.4.2",
    "gsap": "3.13.0",
    "lenis": "1.3.10",
    "pdfjs-dist": "5.6.205",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "5.5.0",
    "recharts": "3.7.0",
    "tailwindcss": "4.1.12",
    "three": "0.179.1"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.3.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.2.0",
    "@types/dompurify": "3.2.0",
    "@types/node": "24.3.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "jsdom": "26.0.0",
    "prettier": "3.5.3",
    "rollup-plugin-visualizer": "6.0.3",
    "terser": "5.43.1",
    "typescript": "5.7.2",
    "vite": "6.3.5",
    "vitest": "3.0.5",
    "web-vitals": "4.2.4"
  },
  "overrides": {
    "cookie": "1.1.1"
  }
}
