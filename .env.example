# ============================================
# Everest Finance - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# ── Vite (client-side, prefixed with VITE_) ──

# Convex deployment URL (from `npx convex dev` or Convex dashboard)
# Used in: src/main.tsx → ConvexReactClient
VITE_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Convex site/HTTP URL (for file uploads via Cloudflare)
# Used in: src/utils/cloudflare.ts
VITE_CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site


# ── Convex server-side (set via `npx convex env set`) ──
# These are NOT in .env — they live in the Convex dashboard
# under Settings → Environment Variables.
# Listed here for documentation only.

# CONVEX_SITE_URL               — Used in: convex/auth.config.ts
# CONVEX_CLOUDFLARE_ACCOUNT_ID  — Used in: convex/api/cloudflare.ts, convex/cloudflare.ts
# CONVEX_CLOUDFLARE_R2_ACCESS_KEY_ID      — Used in: convex/api/cloudflare.ts
# CONVEX_CLOUDFLARE_R2_SECRET_ACCESS_KEY  — Used in: convex/api/cloudflare.ts
# CONVEX_CLOUDFLARE_R2_BUCKET_NAME        — Used in: convex/api/cloudflare.ts
# CONVEX_CLOUDFLARE_IMAGES_API_TOKEN      — Used in: convex/api/cloudflare.ts
