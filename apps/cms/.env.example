# Local development — copy to apps/cms/.env

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/everest_cms
# Local Homebrew Postgres (no password): postgresql://YOUR_MAC_USERNAME@localhost:5432/everest_cms
PAYLOAD_SECRET=change-me-local-dev-secret-min-32-chars
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Optional: POST this URL after a publish (Vercel Deploy Hook)
# SITE_REBUILD_URL=

# Seed script (optional overrides)
SEED_ADMIN_EMAIL=admin@everest-finance.sn
SEED_ADMIN_PASSWORD=EverestAdmin2026!
SEED_ADMIN_NAME=Everest Admin

# Cloudflare R2 (Phase 2 — media uploads)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
