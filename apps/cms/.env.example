# Local development — copy to apps/cms/.env

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/everest_cms
# Local Homebrew Postgres (no password): postgresql://YOUR_MAC_USERNAME@localhost:5432/everest_cms
PAYLOAD_SECRET=change-me-local-dev-secret-min-32-chars
# Public origin for Payload admin + API (same as the Astro site in production).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
# Extra browser origins (local dev). Production unified deploy: only localhost entries needed here.
PAYLOAD_CORS_ORIGINS=http://localhost:4321,http://localhost:8000,http://localhost:3000

# Optional: POST this URL after a publish (Vercel Deploy Hook)
# SITE_REBUILD_URL=

# Seed script (optional overrides)
SEED_ADMIN_EMAIL=admin@everest-finance.sn
SEED_ADMIN_PASSWORD=EverestAdmin2026!
SEED_ADMIN_NAME=Everest Admin

# Cloudflare R2 (optional). Local disk is used when these are unset.
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL is the r2.dev subdomain or custom domain (not the S3 API).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
