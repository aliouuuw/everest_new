{
  "name": "@everest/cms",
  "version": "0.1.0",
  "private": true,
  "description": "Everest Finance headless CMS (Payload + PostgreSQL)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:astro": "cross-env NODE_OPTIONS=--no-deprecation bun run --cwd ../web build",
    "sync:astro": "node scripts/sync-astro-public.mjs",
    "build": "bun run build:astro && bun run sync:astro && cross-env NODE_OPTIONS=--no-deprecation next build",
    "check:seed": "tsx src/seed/htmlToLexical.check.ts && tsx src/seed/site-content.check.ts && tsx src/storage/r2.check.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:admin": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/admin.ts",
    "seed:publications": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/publications.ts",
    "seed:site-content": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/site-content.ts",
    "import:convex": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/seed/import-convex.ts",
    "jobs:fetch-news": "cross-env NODE_OPTIONS=--no-deprecation tsx --env-file=.env src/jobs/fetchExternalNews.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3001",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.82.1",
    "@payloadcms/next": "3.82.1",
    "@payloadcms/richtext-lexical": "3.82.1",
    "@payloadcms/storage-s3": "3.82.1",
    "@payloadcms/ui": "3.82.1",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "payload": "3.82.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.6"
  }
}
