---
import Layout from '../../layouts/Layout.astro'
import ArticlePage from '../../islands/ArticlePage'
import {
  articleToView,
  decodeHtmlEntities,
  externalArticleToView,
  fetchExternalArticles,
  fetchNewsFeed,
  fetchPublishedArticles,
} from '../../lib/payload'

export async function getStaticPaths() {
  const [articles, externals] = await Promise.all([
    fetchPublishedArticles(100),
    fetchExternalArticles(100),
  ])

  return [
    ...articles.docs.map((article) => ({
      params: { slug: article.slug },
      props: {
        article: articleToView(article),
        slug: article.slug,
      },
    })),
    ...externals.docs
      .filter((item) => item.slug)
      .map((item) => ({
        params: { slug: item.slug! },
        props: {
          article: externalArticleToView(item),
          slug: item.slug!,
        },
      })),
  ]
}

const { article, slug } = Astro.props
const feed = await fetchNewsFeed(50)
const related = feed
  .filter((item) => item.slug !== slug)
  .slice(0, 3)
  .map((item) => ({
    href: item.external ? item.href : `/actualites/${item.slug}`,
    title: decodeHtmlEntities(item.title),
    category: item.category,
    imageUrl: item.imageUrl ?? undefined,
    publishedAt: item.publishedAt ?? '',
  }))
---

<Layout title={`${article.title} — Everest Finance`} description={article.excerpt}>
  <ArticlePage client:load article={article} related={related} />
</Layout>
