---
import Layout from '../../layouts/Layout.astro'
import { fetchPublishedArticles, lexicalToHtml } from '../../lib/payload'

export async function getStaticPaths() {
  const { docs } = await fetchPublishedArticles(100)
  return docs.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))
}

const { article } = Astro.props
const html = lexicalToHtml(article.content)
---

<Layout title={`${article.title} — Everest Finance`} description={article.excerpt}>
  <article class="mx-auto max-w-3xl">
    <a href="/actualites" class="text-sm text-secondary">Actualités</a>
    <p class="mt-6 text-xs uppercase tracking-wide text-secondary">{article.category}</p>
    <h1 class="mt-2 text-4xl font-extrabold text-primary">{article.title}</h1>
    {article.imageUrl && (
      <img src={article.imageUrl} alt="" class="mt-6 w-full rounded-xl" />
    )}
    <p class="mt-4 text-lg text-on-surface/70">{article.excerpt}</p>
    <div class="mt-8 text-base leading-7 text-on-surface" set:html={html} />
  </article>
</Layout>
