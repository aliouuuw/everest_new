---
import Layout from '../../layouts/Layout.astro'
import ActualitesPage from '../../islands/ActualitesPage'
import { fetchNewsFeed, fetchSiteContent } from '../../lib/payload'

const [feed, site] = await Promise.all([
  fetchNewsFeed(50),
  fetchSiteContent('actualites'),
])
---

<Layout
  title="Actualités | EVEREST Finance"
>
  <ActualitesPage client:load siteContent={site.docs} news={feed} />
</Layout>
