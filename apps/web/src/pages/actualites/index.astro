---
import Layout from '../../layouts/Layout.astro'
import NewsList from '../../components/NewsList.astro'
import { fetchNewsFeed } from '../../lib/payload'

const items = await fetchNewsFeed(50)
---

<Layout
  title="Actualités — Everest Finance"
  description="Actualités des marchés : Everest Finance, Sika Finance et Madis Invest."
>
  <section class="mx-auto max-w-4xl">
    <a href="/" class="text-sm text-secondary">Accueil</a>
    <h1 class="mt-4 text-4xl font-extrabold text-primary">Actualités</h1>
    <p class="mt-3 text-sm text-on-surface/70">
      Articles Everest Finance, plus les dépêches Sika Finance et Madis Invest.
    </p>
    <NewsList items={items} empty="Aucune actualité pour le moment." />
  </section>
</Layout>
