---
import Layout from '../../layouts/Layout.astro'
import PublicationsPage from '../../islands/PublicationsPage'
import {
  fetchPublishedPublications,
  fetchSiteContent,
  publishedPublicationFiles,
} from '../../lib/payload'
import { ANALYSES_TEXT } from '@/content/analyses'

const [site, pubs] = await Promise.all([
  fetchSiteContent('publications'),
  fetchPublishedPublications(50),
])
---

<Layout title="Analyses & Publications | EVEREST Finance" description={ANALYSES_TEXT['publications.n1']}>
  <PublicationsPage
    client:load
    siteContent={site.docs}
    publications={publishedPublicationFiles(pubs.docs)}
  />
</Layout>
