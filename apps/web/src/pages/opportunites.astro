---
import Layout from '../layouts/Layout.astro'
import ReferentielPage from '../islands/ReferentielPage'
import { fetchSiteContent } from '../lib/payload'
import { OPPORTUNITES_TEXT } from '@/content/relation'

const site = await fetchSiteContent('opportunites')
---

<Layout title="Opportunités | EVEREST Finance" description={OPPORTUNITES_TEXT['opportunites.n1']}>
  <ReferentielPage siteContent={site.docs} pageKey="opportunites" />
</Layout>
