---
import Layout from '../../layouts/Layout.astro'
import PublicationPage from '../../islands/PublicationPage'
import { fetchPublishedPublications, publicationToView } from '../../lib/payload'

export async function getStaticPaths() {
  const { docs } = await fetchPublishedPublications(100)
  return docs.map((publication) => ({
    params: { slug: publication.slug },
    props: { publication: publicationToView(publication) },
  }))
}

const { publication } = Astro.props
---

<Layout title={`${publication.title} — Everest Finance`} description={publication.description}>
  <PublicationPage client:load publication={publication} />
</Layout>
