---
import '../../styles/global.css'
import { fetchPublishedPublications } from '../../lib/payload'

const { docs } = await fetchPublishedPublications(50)
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Publications — Everest Finance</title>
  </head>
  <body>
    <main class="min-h-screen px-6 py-16">
      <section class="mx-auto max-w-4xl">
        <a href="/" class="text-sm text-secondary">Accueil</a>
        <h1 class="mt-4 text-4xl font-extrabold text-primary">Publications</h1>
        <ul class="mt-8 grid gap-4">
          {docs.map((item) => (
            <li class="rounded-xl border border-border bg-surface p-5">
              <p class="text-xs uppercase tracking-wide text-secondary">{item.category}</p>
              <a href={`/publications/${item.slug}`} class="mt-2 block text-lg font-semibold text-primary">
                {item.title}
              </a>
              <p class="mt-2 text-sm text-on-surface/70">{item.excerpt}</p>
            </li>
          ))}
        </ul>
      </section>
    </main>
  </body>
</html>
