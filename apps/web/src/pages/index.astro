---
import Layout from '../layouts/Layout.astro'
import HomePage from '../islands/HomePage'
import { fetchNewsFeed, fetchSiteContent } from '../lib/payload'

const [site, feed] = await Promise.all([
  fetchSiteContent('home'),
  fetchNewsFeed(20),
])
const siteContent = site.docs
const news = feed.slice(0, 6)
---

<Layout title="Everest Finance">
  <HomePage client:load siteContent={siteContent} news={news} />
</Layout>
