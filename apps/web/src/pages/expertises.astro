---
import Layout from '../layouts/Layout.astro'
import MarketingPage from '../islands/MarketingPage'
import { fetchSiteContent } from '../lib/payload'

const site = await fetchSiteContent('expertises')
---

<Layout title="Expertises — Everest Finance">
  <MarketingPage client:load siteContent={site.docs} pageKey="expertises" />
</Layout>
