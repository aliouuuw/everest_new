---
import Layout from '../layouts/Layout.astro'
import MarketingPage from '../islands/MarketingPage'
import { fetchSiteContent } from '../lib/payload'
import { SOCIETE_TEXT } from '@/content/societe'

const site = await fetchSiteContent('about')
---

<Layout title="La société | EVEREST Finance" description={SOCIETE_TEXT['about.histoire.n1']}>
  <MarketingPage client:load siteContent={site.docs} pageKey="about" />
</Layout>
