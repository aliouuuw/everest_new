---
import '../styles/global.css'
import SiteShell from '../islands/SiteShell'

type Props = {
  title: string
  description?: string
}

const {
  title,
  description = "EVEREST Finance, Société de Gestion et d'Intermédiation agréée par l'AMF-UMOA (n° SGI/DA/2016/60). Accès intégré aux marchés financiers de l'UEMOA.",
} = Astro.props
---

<html lang="fr" class="astro-public">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SiteShell client:load pathname={Astro.url.pathname}>
      <slot />
    </SiteShell>
  </body>
</html>
