---
import '../styles/global.css'
import SiteShell from '../islands/SiteShell'

type Props = {
  title: string
  description?: string
}

const {
  title,
  description = 'Everest Finance — Gestion de patrimoine et marchés de capitaux',
} = Astro.props
---

<html lang="fr" class="astro-public">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SiteShell client:load pathname={Astro.url.pathname}>
      <slot />
    </SiteShell>
  </body>
</html>
