---
import type { NewsItem } from '../lib/payload'

type Props = {
  items: NewsItem[]
  empty: string
}

const { items, empty } = Astro.props

function formatDate(value: string | null): string {
  if (!value) return ''
  const ms = Date.parse(value)
  if (Number.isNaN(ms)) return ''
  return new Date(ms).toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  })
}
---

{
  items.length === 0 ? (
    <p class="mt-8 text-sm text-on-surface/60">{empty}</p>
  ) : (
    <ul class="mt-8 grid gap-4">
      {items.map((item) => (
        <li class="rounded-xl border border-border bg-surface p-5">
          <p class="text-xs uppercase tracking-wide text-secondary">
            {item.sourceName}
            {item.category ? ` · ${item.category}` : ''}
            {item.publishedAt ? ` · ${formatDate(item.publishedAt)}` : ''}
          </p>
          <a
            href={item.href}
            class="mt-2 block text-lg font-semibold text-primary"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.title}
            {item.external && (
              <span class="ml-2 text-xs font-medium normal-case text-secondary">
                source
              </span>
            )}
          </a>
          <p class="mt-2 text-sm text-on-surface/70">{item.excerpt}</p>
        </li>
      ))}
    </ul>
  )
}
